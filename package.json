{
  "name": "orangehrm-playwright-assignment",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright TypeScript solution for the OrangeHRM Testing Engineer Assignment",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:part1": "playwright test tests/part1.spec.ts",
    "test:part2": "playwright test tests/part2.spec.ts",
    "test:smoke": "playwright test --grep @smoke",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.7",
    "typescript": "^5.7.3"
  }
}
